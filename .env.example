# =============================================================================
# Fitness App — backend (wger) env template  [LOCAL DEVELOPMENT]
# =============================================================================
# Nguồn: config/prod.env của https://github.com/wger-project/docker
# (bản đầy đủ được giữ ở .wger-prod.env.ref để tra cứu các option khác)
#
# Cách dùng:   cp .env.example .env
# File .env đã bị .gitignore — KHÔNG commit.
#
# Đã lược bỏ so với prod.env chính thức: các biến powersync (PS_*, JWT_*),
# vì stack này không chạy service powersync. NGOẠI LỆ: PS_DATABASE_URI vẫn phải
# giữ — bất chấp tiền tố PS_, chính Django đọc biến này để kết nối Postgres.
# -----------------------------------------------------------------------------

# ---------- BẮT BUỘC ĐỔI TRƯỚC KHI DEPLOY ----------
# Chuỗi ngẫu nhiên >= 50 ký tự. Sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Nếu để trống, wger sinh key mới mỗi lần khởi động -> mọi session bị vô hiệu hoá.
SECRET_KEY=CHANGE_ME_local_dev_only_not_a_real_secret_key_0123456789

# URL gốc của app. Stack này expose trực tiếp port 8000 (không có nginx).
SITE_URL=http://localhost:8000

# ---------- Timezone ----------
TIME_ZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh

# ---------- Database ----------
# Container postgres đọc trực tiếp 3 biến này để khởi tạo DB lần đầu.
POSTGRES_USER=wger
POSTGRES_PASSWORD=wger
POSTGRES_DB=wger

# Django đọc PS_DATABASE_URI để kết nối Postgres. Thiếu biến này thì wger
# âm thầm fallback sang SQLite. Nếu đổi password ở trên, sửa cả URI này.
PS_DATABASE_URI=postgres://wger:wger@db:5432/wger

# Chạy migration khi khởi động
DJANGO_PERFORM_MIGRATIONS=True

# ---------- Cache (Redis) ----------
DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://cache:6379/1
DJANGO_CACHE_TIMEOUT=1296000
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient

# ---------- Celery ----------
USE_CELERY=True
CELERY_BROKER=redis://cache:6379/2
CELERY_BACKEND=redis://cache:6379/2
CELERY_WORKER_CONCURRENCY=2

# ---------- Application ----------
# Instance wger dùng làm nguồn đồng bộ exercise / ingredient.
WGER_INSTANCE=https://wger.de
ALLOW_REGISTRATION=True
ALLOW_GUEST_USERS=False
ALLOW_UPLOAD_VIDEOS=True
MIN_ACCOUNT_AGE_TO_TRUST=21

# Đồng bộ exercise DB định kỳ qua celery (job chạy 1 lần/tuần).
# LƯU Ý: DB exercise ban đầu RỖNG. Muốn có data ngay thì chạy tay:
#   docker compose exec web python3 manage.py sync-exercises
# (xem README mục 5)
SYNC_EXERCISES_CELERY=True
SYNC_EXERCISE_IMAGES_CELERY=True
SYNC_EXERCISE_VIDEOS_CELERY=True

# Đồng bộ ingredient (dinh dưỡng). Tắt bớt cho local dev vì dump khá nặng.
SYNC_INGREDIENTS_CELERY=False
SYNC_INGREDIENTS_DUMP_URL=https://wger.de/media/ingredients/ingredients.jsonl.gz
DOWNLOAD_INGREDIENTS_FROM=WGER

# Giữ cache API exercise luôn "ấm"
CACHE_API_EXERCISES_CELERY=True
CACHE_API_EXERCISES_CELERY_FORCE_UPDATE=True
EXERCISE_CACHE_TTL=2419200

# ---------- Chống brute-force login (django-axes) ----------
AXES_ENABLED=True
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_TIME=30
AXES_HANDLER=axes.handlers.cache.AxesCacheHandler
AXES_LOCKOUT_PARAMETERS=ip_address

# ---------- Server ----------
DJANGO_DEBUG=False
WGER_USE_GUNICORN=True
WGER_PORT=8000
DJANGO_COLLECTSTATIC_ON_STARTUP=True
DJANGO_CLEAR_STATIC_FIRST=False
LOG_LEVEL_PYTHON=INFO
GUNICORN_CMD_ARGS="--workers 2 --threads 2 --worker-class gthread --timeout 240"

# Số reverse proxy đứng trước app. Stack này KHÔNG có nginx -> 0.
# (prod.env chính thức để 1 vì có nginx). Chỉ ảnh hưởng throttling của DRF.
NUMBER_OF_PROXIES=0

# ---------- JWT (mobile app / client auth) ----------
ACCESS_TOKEN_LIFETIME=10
REFRESH_TOKEN_LIFETIME=2880

# ---------- Khác ----------
USE_RECAPTCHA=False
EXPOSE_PROMETHEUS_METRICS=False
FROM_EMAIL=Fitness App <noreply@example.com>

# Nếu gặp lỗi CSRF khi truy cập bằng domain/IP khác localhost:
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
